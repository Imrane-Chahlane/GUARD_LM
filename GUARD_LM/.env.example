DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guard_lm?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional external AI providers. The app uses mock providers when these are empty.
LLM_PROVIDER="mock"
EMBEDDING_PROVIDER="mock"
OPENAI_API_KEY=""

# Seed-only local demo key. Do not use this value in production.
DEMO_CLIENT_API_KEY="glm_demo_local_development_key"
